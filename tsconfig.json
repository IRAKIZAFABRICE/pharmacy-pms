{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "pack",
    ".git",
    "postgresql-18.4-2-windows-x64-binaries",
    "packages/electron/release",
    "packages/electron/staged",
    "packages/electron/resources",
    "packages/electron/electron-cache",
    "packages/backend/dist",
    "packages/frontend/dist"
  ]
}