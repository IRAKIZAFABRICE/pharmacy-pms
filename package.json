{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "description": "Pharmacy Management System for Rwanda",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:electron": "npm run dev --workspace=pharmacy-pms",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:electron": "npm run build --workspace=pharmacy-pms",
    "dist:win": "npm run dist --workspace=pharmacy-pms",
    "kill": "taskkill /F /IM \"Pharmacy PMS.exe\" /IM \"postgres.exe\" /IM electron.exe /T 2>nul || exit 0",
    "dev": "yarn kill && concurrently -k -n \"FRONTEND,BACKEND,ELECTRON\" -c \"cyan.bold,blue.bold\" \"yarn dev:frontend\" \"yarn dev:electron\" \"yarn dev:backend\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "electron@43.1.0": true,
    "bcrypt@6.0.0": true
  }
}
