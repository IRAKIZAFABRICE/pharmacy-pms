# ====================================================
# Pharmacy Management System - Environment Variables
# ====================================================
# Copy this file to .env and fill in your values

# ==================== APPLICATION ====================
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ==================== DATABASE ====================
DATABASE_URL=postgresql://pharma_admin:Pharma@2024@localhost:5432/pharmacy_db

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ==================== RRA FISCALIZATION (EBM/VSDC/OSDC) ====================
# Enable RRA integration
RRA_ENABLED=false

# RRA CIS Developer Credentials (obtain from RRA)
RRA_API_KEY=your-rra-cis-developer-key
RRA_TIN=1000000000
RRA_DEVICE_KEY=your-rra-fiscal-device-key

# VSDC (Virtual Sales Data Controller) - for local fiscal device
RRA_VSDC_DEVICE_ID=VSDC-001
RRA_VSDC_SERIAL=RRA-EBM-001
RRA_VSDC_URL=http://localhost:8080/ebm

# OSDC (Online Sales Data Controller) - for cloud fiscal API
# If using OSDC instead of VSDC, use the RRA cloud API URL
# RRA_API_URL=https://api.rra.gov.rw/fiscalization/v2

# RRA API Configuration
RRA_API_URL=https://api.rra.gov.rw/fiscalization
RRA_TIMEOUT=30000
RRA_RETRY_ATTEMPTS=3

# ==================== RSSB VCDC INSURANCE ====================
# Enable RSSB integration
RSSB_ENABLED=false

# RSSB Provider Credentials (obtain from RSSB)
RSSB_PROVIDER_CODE=PHARM-001
RSSB_PROVIDER_NAME=Pharmacy PMS
RSSB_PROVIDER_TIN=your-pharmacy-tin
RSSB_API_KEY=your-rssb-api-key

# RSSB VCDC API Configuration
RSSB_API_URL=https://api.rssb.gov.rw/vcdc/v1
RSSB_TIMEOUT=30000
RSSB_RETRY_ATTEMPTS=3

# ==================== DATA ENCRYPTION (Law Nº 058/2021) ====================
# Generate a 64-character hex key (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=1

# ==================== NOTIFICATIONS ====================
NOTIFICATION_ENABLED=true
NOTIFICATION_CHECK_INTERVAL=60000

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

